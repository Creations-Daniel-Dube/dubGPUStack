.version 7.0
.target sm_61
.address_size 64

// NAFNet mini, fp32. Tile GEMM 64x64 for 1x1 convolutions.
.visible .entry conv1x1(
    .param .u64 p_in,
    .param .u64 p_w,
    .param .u64 p_bias,
    .param .u64 p_out,
    .param .u32 p_cin,
    .param .u32 p_cout,
    .param .u32 p_spatial
)
{
    .reg .pred %p;
    .reg .u32 %tx, %ty, %lin, %cta, %m0, %n0, %k0, %iter, %e, %row, %col;
    .reg .u32 %gm, %gk, %gn, %kk, %row0, %col0, %ai, %bi, %cin, %cout, %spatial;
    .reg .u64 %in, %w, %bias, %out, %as, %bs, %asg, %bsg, %addr, %off;
    .reg .f32 %val, %a0, %a1, %a2, %a3, %b0, %b1, %b2, %b3, %biasv;
    .reg .f32 %c00, %c01, %c02, %c03, %c10, %c11, %c12, %c13;
    .reg .f32 %c20, %c21, %c22, %c23, %c30, %c31, %c32, %c33;
    .shared .align 16 .f32 As[1024];
    .shared .align 16 .f32 Bs[1024];

    ld.param.u64 %in, [p_in];
    ld.param.u64 %w, [p_w];
    ld.param.u64 %bias, [p_bias];
    ld.param.u64 %out, [p_out];
    ld.param.u32 %cin, [p_cin];
    ld.param.u32 %cout, [p_cout];
    ld.param.u32 %spatial, [p_spatial];
    mov.u32 %tx, %tid.x;
    mov.u32 %ty, %tid.y;
    mad.lo.u32 %lin, %ty, 16, %tx;
    mov.u32 %cta, %ctaid.y;
    shl.b32 %m0, %cta, 6;
    mov.u32 %cta, %ctaid.x;
    shl.b32 %n0, %cta, 6;
    mov.u64 %as, As;
    mov.u64 %bs, Bs;
    mov.f32 %c00, 0f00000000;
    mov.f32 %c01, 0f00000000;
    mov.f32 %c02, 0f00000000;
    mov.f32 %c03, 0f00000000;
    mov.f32 %c10, 0f00000000;
    mov.f32 %c11, 0f00000000;
    mov.f32 %c12, 0f00000000;
    mov.f32 %c13, 0f00000000;
    mov.f32 %c20, 0f00000000;
    mov.f32 %c21, 0f00000000;
    mov.f32 %c22, 0f00000000;
    mov.f32 %c23, 0f00000000;
    mov.f32 %c30, 0f00000000;
    mov.f32 %c31, 0f00000000;
    mov.f32 %c32, 0f00000000;
    mov.f32 %c33, 0f00000000;
    mov.u32 %k0, 0;

kloop:
    setp.ge.u32 %p, %k0, %cin;
    @%p bra kdone;
    mov.u32 %iter, 0;
aload:
    setp.ge.u32 %p, %iter, 4;
    @%p bra aload_done;
    mad.lo.u32 %e, %iter, 256, %lin;
    shr.u32 %row, %e, 4;
    and.b32 %col, %e, 15;
    add.u32 %gm, %m0, %row;
    add.u32 %gk, %k0, %col;
    mov.f32 %val, 0f00000000;
    setp.ge.u32 %p, %gm, %cout;
    setp.ge.or.u32 %p, %gk, %cin, %p;
    @%p bra astore;
    mul.wide.u32 %off, %gm, %cin;
    cvt.u64.u32 %addr, %gk;
    add.u64 %off, %off, %addr;
    shl.b64 %off, %off, 2;
    add.u64 %addr, %w, %off;
    ld.global.f32 %val, [%addr];
astore:
    mul.wide.u32 %off, %e, 4;
    add.u64 %addr, %as, %off;
    st.shared.f32 [%addr], %val;
    shr.u32 %row, %e, 6;
    and.b32 %col, %e, 63;
    add.u32 %gk, %k0, %row;
    add.u32 %gn, %n0, %col;
    mov.f32 %val, 0f00000000;
    setp.ge.u32 %p, %gk, %cin;
    setp.ge.or.u32 %p, %gn, %spatial, %p;
    @%p bra bstore;
    mul.wide.u32 %off, %gk, %spatial;
    cvt.u64.u32 %addr, %gn;
    add.u64 %off, %off, %addr;
    shl.b64 %off, %off, 2;
    add.u64 %addr, %in, %off;
    ld.global.f32 %val, [%addr];
bstore:
    mul.wide.u32 %off, %e, 4;
    add.u64 %addr, %bs, %off;
    st.shared.f32 [%addr], %val;
    add.u32 %iter, %iter, 1;
    bra aload;
aload_done:
    bar.sync 0;
    shl.b32 %row0, %ty, 2;
    shl.b32 %col0, %tx, 2;
    mov.u32 %kk, 0;
floop:
    setp.ge.u32 %p, %kk, 16;
    @%p bra fdone;
    mad.lo.u32 %ai, %row0, 16, %kk;
    mul.wide.u32 %off, %ai, 4;
    add.u64 %addr, %as, %off;
    ld.shared.f32 %a0, [%addr];
    add.u32 %ai, %ai, 16;
    mul.wide.u32 %off, %ai, 4;
    add.u64 %addr, %as, %off;
    ld.shared.f32 %a1, [%addr];
    add.u32 %ai, %ai, 16;
    mul.wide.u32 %off, %ai, 4;
    add.u64 %addr, %as, %off;
    ld.shared.f32 %a2, [%addr];
    add.u32 %ai, %ai, 16;
    mul.wide.u32 %off, %ai, 4;
    add.u64 %addr, %as, %off;
    ld.shared.f32 %a3, [%addr];
    mad.lo.u32 %bi, %kk, 64, %col0;
    mul.wide.u32 %off, %bi, 4;
    add.u64 %addr, %bs, %off;
    ld.shared.f32 %b0, [%addr];
    add.u32 %bi, %bi, 1;
    mul.wide.u32 %off, %bi, 4;
    add.u64 %addr, %bs, %off;
    ld.shared.f32 %b1, [%addr];
    add.u32 %bi, %bi, 1;
    mul.wide.u32 %off, %bi, 4;
    add.u64 %addr, %bs, %off;
    ld.shared.f32 %b2, [%addr];
    add.u32 %bi, %bi, 1;
    mul.wide.u32 %off, %bi, 4;
    add.u64 %addr, %bs, %off;
    ld.shared.f32 %b3, [%addr];
    fma.rn.f32 %c00, %a0, %b0, %c00;
    fma.rn.f32 %c01, %a0, %b1, %c01;
    fma.rn.f32 %c02, %a0, %b2, %c02;
    fma.rn.f32 %c03, %a0, %b3, %c03;
    fma.rn.f32 %c10, %a1, %b0, %c10;
    fma.rn.f32 %c11, %a1, %b1, %c11;
    fma.rn.f32 %c12, %a1, %b2, %c12;
    fma.rn.f32 %c13, %a1, %b3, %c13;
    fma.rn.f32 %c20, %a2, %b0, %c20;
    fma.rn.f32 %c21, %a2, %b1, %c21;
    fma.rn.f32 %c22, %a2, %b2, %c22;
    fma.rn.f32 %c23, %a2, %b3, %c23;
    fma.rn.f32 %c30, %a3, %b0, %c30;
    fma.rn.f32 %c31, %a3, %b1, %c31;
    fma.rn.f32 %c32, %a3, %b2, %c32;
    fma.rn.f32 %c33, %a3, %b3, %c33;
    add.u32 %kk, %kk, 1;
    bra floop;
fdone:
    bar.sync 0;
    add.u32 %k0, %k0, 16;
    bra kloop;
kdone:
    shl.b32 %row0, %ty, 2;
    shl.b32 %col0, %tx, 2;
    add.u32 %gm, %m0, %row0;
    add.u32 %gn, %n0, %col0;
    setp.ge.u32 %p, %gm, %cout;
    setp.ge.or.u32 %p, %gn, %spatial, %p;
    @%p bra s01;
    mul.wide.u32 %off, %gm, 4;
    add.u64 %addr, %bias, %off;
    ld.global.f32 %biasv, [%addr];
    add.f32 %c00, %c00, %biasv;
    add.f32 %c01, %c01, %biasv;
    add.f32 %c02, %c02, %biasv;
    add.f32 %c03, %c03, %biasv;
    mul.wide.u32 %off, %gm, %spatial;
    cvt.u64.u32 %addr, %gn;
    add.u64 %off, %off, %addr;
    shl.b64 %off, %off, 2;
    add.u64 %addr, %out, %off;
    st.global.f32 [%addr], %c00;
    add.u32 %gn, %gn, 1;
    setp.ge.u32 %p, %gn, %spatial;
    @%p bra s01;
    add.u64 %addr, %addr, 4;
    st.global.f32 [%addr], %c01;
    add.u32 %gn, %gn, 1;
    setp.ge.u32 %p, %gn, %spatial;
    @%p bra s01;
    add.u64 %addr, %addr, 4;
    st.global.f32 [%addr], %c02;
    add.u32 %gn, %gn, 1;
    setp.ge.u32 %p, %gn, %spatial;
    @%p bra s01;
    add.u64 %addr, %addr, 4;
    st.global.f32 [%addr], %c03;
s01:
    add.u32 %gm, %gm, 1;
    add.u32 %gn, %n0, %col0;
    setp.ge.u32 %p, %gm, %cout;
    setp.ge.or.u32 %p, %gn, %spatial, %p;
    @%p bra s02;
    mul.wide.u32 %off, %gm, 4;
    add.u64 %addr, %bias, %off;
    ld.global.f32 %biasv, [%addr];
    add.f32 %c10, %c10, %biasv;
    add.f32 %c11, %c11, %biasv;
    add.f32 %c12, %c12, %biasv;
    add.f32 %c13, %c13, %biasv;
    mul.wide.u32 %off, %gm, %spatial;
    cvt.u64.u32 %addr, %gn;
    add.u64 %off, %off, %addr;
    shl.b64 %off, %off, 2;
    add.u64 %addr, %out, %off;
    st.global.f32 [%addr], %c10;
    add.u32 %gn, %gn, 1;
    setp.ge.u32 %p, %gn, %spatial;
    @%p bra s02;
    add.u64 %addr, %addr, 4;
    st.global.f32 [%addr], %c11;
    add.u32 %gn, %gn, 1;
    setp.ge.u32 %p, %gn, %spatial;
    @%p bra s02;
    add.u64 %addr, %addr, 4;
    st.global.f32 [%addr], %c12;
    add.u32 %gn, %gn, 1;
    setp.ge.u32 %p, %gn, %spatial;
    @%p bra s02;
    add.u64 %addr, %addr, 4;
    st.global.f32 [%addr], %c13;
s02:
    add.u32 %gm, %gm, 1;
    add.u32 %gn, %n0, %col0;
    setp.ge.u32 %p, %gm, %cout;
    setp.ge.or.u32 %p, %gn, %spatial, %p;
    @%p bra s03;
    mul.wide.u32 %off, %gm, 4;
    add.u64 %addr, %bias, %off;
    ld.global.f32 %biasv, [%addr];
    add.f32 %c20, %c20, %biasv;
    add.f32 %c21, %c21, %biasv;
    add.f32 %c22, %c22, %biasv;
    add.f32 %c23, %c23, %biasv;
    mul.wide.u32 %off, %gm, %spatial;
    cvt.u64.u32 %addr, %gn;
    add.u64 %off, %off, %addr;
    shl.b64 %off, %off, 2;
    add.u64 %addr, %out, %off;
    st.global.f32 [%addr], %c20;
    add.u32 %gn, %gn, 1;
    setp.ge.u32 %p, %gn, %spatial;
    @%p bra s03;
    add.u64 %addr, %addr, 4;
    st.global.f32 [%addr], %c21;
    add.u32 %gn, %gn, 1;
    setp.ge.u32 %p, %gn, %spatial;
    @%p bra s03;
    add.u64 %addr, %addr, 4;
    st.global.f32 [%addr], %c22;
    add.u32 %gn, %gn, 1;
    setp.ge.u32 %p, %gn, %spatial;
    @%p bra s03;
    add.u64 %addr, %addr, 4;
    st.global.f32 [%addr], %c23;
s03:
    add.u32 %gm, %gm, 1;
    add.u32 %gn, %n0, %col0;
    setp.ge.u32 %p, %gm, %cout;
    setp.ge.or.u32 %p, %gn, %spatial, %p;
    @%p bra sdone;
    mul.wide.u32 %off, %gm, 4;
    add.u64 %addr, %bias, %off;
    ld.global.f32 %biasv, [%addr];
    add.f32 %c30, %c30, %biasv;
    add.f32 %c31, %c31, %biasv;
    add.f32 %c32, %c32, %biasv;
    add.f32 %c33, %c33, %biasv;
    mul.wide.u32 %off, %gm, %spatial;
    cvt.u64.u32 %addr, %gn;
    add.u64 %off, %off, %addr;
    shl.b64 %off, %off, 2;
    add.u64 %addr, %out, %off;
    st.global.f32 [%addr], %c30;
    add.u32 %gn, %gn, 1;
    setp.ge.u32 %p, %gn, %spatial;
    @%p bra sdone;
    add.u64 %addr, %addr, 4;
    st.global.f32 [%addr], %c31;
    add.u32 %gn, %gn, 1;
    setp.ge.u32 %p, %gn, %spatial;
    @%p bra sdone;
    add.u64 %addr, %addr, 4;
    st.global.f32 [%addr], %c32;
    add.u32 %gn, %gn, 1;
    setp.ge.u32 %p, %gn, %spatial;
    @%p bra sdone;
    add.u64 %addr, %addr, 4;
    st.global.f32 [%addr], %c33;
sdone:
    ret;
}

.visible .entry dwconv3(
    .param .u64 p_in,
    .param .u64 p_w,
    .param .u64 p_bias,
    .param .u64 p_out,
    .param .u32 p_c,
    .param .u32 p_h,
    .param .u32 p_width
)
{
    .reg .pred %p, %q;
    .reg .u32 %gid, %n, %c, %h, %w, %spatial, %s, %y, %x, %oc, %ky, %kx, %cta, %nt;
    .reg .s32 %iy, %ix, %sy, %sx, %sh, %sw;
    .reg .u64 %in, %wt, %bias, %out, %addr, %off;
    .reg .f32 %acc, %pix, %kv;
    ld.param.u64 %in, [p_in];
    ld.param.u64 %wt, [p_w];
    ld.param.u64 %bias, [p_bias];
    ld.param.u64 %out, [p_out];
    ld.param.u32 %c, [p_c];
    ld.param.u32 %h, [p_h];
    ld.param.u32 %w, [p_width];
    mov.u32 %gid, %tid.x;
    mov.u32 %cta, %ctaid.x;
    mov.u32 %nt, %ntid.x;
    mad.lo.u32 %gid, %cta, %nt, %gid;
    mul.lo.u32 %spatial, %h, %w;
    mul.lo.u32 %n, %c, %spatial;
    setp.ge.u32 %p, %gid, %n;
    @%p ret;
    div.u32 %oc, %gid, %spatial;
    rem.u32 %s, %gid, %spatial;
    div.u32 %y, %s, %w;
    rem.u32 %x, %s, %w;
    mul.wide.u32 %off, %oc, 4;
    add.u64 %addr, %bias, %off;
    ld.global.f32 %acc, [%addr];
    cvt.s32.u32 %sy, %y;
    cvt.s32.u32 %sx, %x;
    cvt.s32.u32 %sh, %h;
    cvt.s32.u32 %sw, %w;
    mov.u32 %ky, 0;
ky:
    setp.ge.u32 %p, %ky, 3;
    @%p bra kydone;
    mov.u32 %kx, 0;
kx:
    setp.ge.u32 %p, %kx, 3;
    @%p bra kxdone;
    cvt.s32.u32 %iy, %ky;
    add.s32 %iy, %sy, %iy;
    sub.s32 %iy, %iy, 1;
    cvt.s32.u32 %ix, %kx;
    add.s32 %ix, %sx, %ix;
    sub.s32 %ix, %ix, 1;
    mov.f32 %pix, 0f00000000;
    setp.lt.s32 %q, %iy, 0;
    setp.ge.or.s32 %q, %iy, %sh, %q;
    setp.lt.or.s32 %q, %ix, 0, %q;
    setp.ge.or.s32 %q, %ix, %sw, %q;
    @%q bra kskip;
    cvt.u32.s32 %y, %iy;
    cvt.u32.s32 %x, %ix;
    mad.lo.u32 %s, %oc, %h, %y;
    mad.lo.u32 %s, %s, %w, %x;
    mul.wide.u32 %off, %s, 4;
    add.u64 %addr, %in, %off;
    ld.global.f32 %pix, [%addr];
kskip:
    mad.lo.u32 %s, %ky, 3, %kx;
    mad.lo.u32 %s, %oc, 9, %s;
    mul.wide.u32 %off, %s, 4;
    add.u64 %addr, %wt, %off;
    ld.global.f32 %kv, [%addr];
    fma.rn.f32 %acc, %pix, %kv, %acc;
    add.u32 %kx, %kx, 1;
    bra kx;
kxdone:
    add.u32 %ky, %ky, 1;
    bra ky;
kydone:
    mul.wide.u32 %off, %gid, 4;
    add.u64 %addr, %out, %off;
    st.global.f32 [%addr], %acc;
    ret;
}

.visible .entry conv3x3(
    .param .u64 p_in,
    .param .u64 p_w,
    .param .u64 p_bias,
    .param .u64 p_out,
    .param .u32 p_cin,
    .param .u32 p_cout,
    .param .u32 p_h,
    .param .u32 p_width
)
{
    .reg .pred %p, %q;
    .reg .u32 %gid, %n, %cin, %cout, %h, %w, %spatial, %s, %y, %x, %oc, %ic, %ky, %kx, %cta, %nt;
    .reg .s32 %iy, %ix, %sy, %sx, %sh, %sw;
    .reg .u64 %in, %wt, %bias, %out, %addr, %off;
    .reg .f32 %acc, %pix, %kv;
    ld.param.u64 %in, [p_in];
    ld.param.u64 %wt, [p_w];
    ld.param.u64 %bias, [p_bias];
    ld.param.u64 %out, [p_out];
    ld.param.u32 %cin, [p_cin];
    ld.param.u32 %cout, [p_cout];
    ld.param.u32 %h, [p_h];
    ld.param.u32 %w, [p_width];
    mov.u32 %gid, %tid.x;
    mov.u32 %cta, %ctaid.x;
    mov.u32 %nt, %ntid.x;
    mad.lo.u32 %gid, %cta, %nt, %gid;
    mul.lo.u32 %spatial, %h, %w;
    mul.lo.u32 %n, %cout, %spatial;
    setp.ge.u32 %p, %gid, %n;
    @%p ret;
    div.u32 %oc, %gid, %spatial;
    rem.u32 %s, %gid, %spatial;
    div.u32 %y, %s, %w;
    rem.u32 %x, %s, %w;
    mul.wide.u32 %off, %oc, 4;
    add.u64 %addr, %bias, %off;
    ld.global.f32 %acc, [%addr];
    cvt.s32.u32 %sy, %y;
    cvt.s32.u32 %sx, %x;
    cvt.s32.u32 %sh, %h;
    cvt.s32.u32 %sw, %w;
    mov.u32 %ic, 0;
icloop:
    setp.ge.u32 %p, %ic, %cin;
    @%p bra icdone;
    mov.u32 %ky, 0;
ky:
    setp.ge.u32 %p, %ky, 3;
    @%p bra kydone;
    mov.u32 %kx, 0;
kx:
    setp.ge.u32 %p, %kx, 3;
    @%p bra kxdone;
    cvt.s32.u32 %iy, %ky;
    add.s32 %iy, %sy, %iy;
    sub.s32 %iy, %iy, 1;
    cvt.s32.u32 %ix, %kx;
    add.s32 %ix, %sx, %ix;
    sub.s32 %ix, %ix, 1;
    mov.f32 %pix, 0f00000000;
    setp.lt.s32 %q, %iy, 0;
    setp.ge.or.s32 %q, %iy, %sh, %q;
    setp.lt.or.s32 %q, %ix, 0, %q;
    setp.ge.or.s32 %q, %ix, %sw, %q;
    @%q bra kskip;
    cvt.u32.s32 %y, %iy;
    cvt.u32.s32 %x, %ix;
    mad.lo.u32 %s, %ic, %h, %y;
    mad.lo.u32 %s, %s, %w, %x;
    mul.wide.u32 %off, %s, 4;
    add.u64 %addr, %in, %off;
    ld.global.f32 %pix, [%addr];
kskip:
    mad.lo.u32 %s, %oc, %cin, %ic;
    mad.lo.u32 %s, %s, 3, %ky;
    mad.lo.u32 %s, %s, 3, %kx;
    mul.wide.u32 %off, %s, 4;
    add.u64 %addr, %wt, %off;
    ld.global.f32 %kv, [%addr];
    fma.rn.f32 %acc, %pix, %kv, %acc;
    add.u32 %kx, %kx, 1;
    bra kx;
kxdone:
    add.u32 %ky, %ky, 1;
    bra ky;
kydone:
    add.u32 %ic, %ic, 1;
    bra icloop;
icdone:
    mul.wide.u32 %off, %gid, 4;
    add.u64 %addr, %out, %off;
    st.global.f32 [%addr], %acc;
    ret;
}

.visible .entry conv_k2s2(
    .param .u64 p_in,
    .param .u64 p_w,
    .param .u64 p_bias,
    .param .u64 p_out,
    .param .u32 p_cin,
    .param .u32 p_cout,
    .param .u32 p_h,
    .param .u32 p_width
)
{
    .reg .pred %p;
    .reg .u32 %gid, %n, %cin, %cout, %h, %w, %oh, %ow, %spatial, %s, %y, %x, %oc, %ic, %ky, %kx, %iy, %ix, %cta, %nt;
    .reg .u64 %in, %wt, %bias, %out, %addr, %off;
    .reg .f32 %acc, %pix, %kv;
    ld.param.u64 %in, [p_in];
    ld.param.u64 %wt, [p_w];
    ld.param.u64 %bias, [p_bias];
    ld.param.u64 %out, [p_out];
    ld.param.u32 %cin, [p_cin];
    ld.param.u32 %cout, [p_cout];
    ld.param.u32 %h, [p_h];
    ld.param.u32 %w, [p_width];
